# Public (exposed to client)
PUBLIC_BASE_URL=https://interactive.thenewhumanitarian.org
PUBLIC_MAPBOX_TOKEN=
PUBLIC_GA4_ID=G-XXXXXXXXXX

# Private (server-side only)
GA4_API_SECRET=
EVENTBRITE_API_KEY=
EVENTBRITE_API_TOKEN=

# Climate splash. Use the intended Supabase project's server-only sb_secret_ key.
CLIMATE_SUPABASE_URL=
CLIMATE_SUPABASE_SECRET_KEY=

# Optional public key for the climate wall's anonymous Realtime cursors.
PUBLIC_CLIMATE_SUPABASE_PUBLISHABLE_KEY=

# Optional JSON array of phrases to screen out of public wall submissions.
CLIMATE_BLOCKED_PHRASES=

# AI screening, short terms and phrasing suggestions for public posts. Private messages are never sent.
# amazee.ai private LLM gateway (TNH's existing contract, Swiss region). Tried first when set.
# Create a dedicated key for this app in the amazee.ai dashboard rather than reusing Drupal's.
AMAZEE_AI_API_KEY=
# Optional: defaults to https://llm.ch103.amazee.ai and claude-haiku-5-5
AMAZEE_AI_BASE_URL=
AMAZEE_AI_MODEL=
# MiniMax directly (used when amazee.ai isn't set): https://platform.minimax.io
MINIMAX_API_KEY=
# Optional: MiniMax-M3 (default) or MiniMax-M3.1-Flash
CLIMATE_MINIMAX_MODEL=
# Fallback: AI screening of public wall posts via OpenRouter (https://openrouter.ai/keys). Private messages are never sent.
OPENROUTER_API_KEY=
# Comma-separated fallback list. Defaults to MiniMax M3, then OpenAI's open safety classifier.
CLIMATE_MODERATION_MODELS=minimax/minimax-m3,openai/gpt-oss-safeguard-20b
# true = posts the AI marks "allow" publish immediately; otherwise every post waits for an editor.
CLIMATE_AUTO_PUBLISH=false
